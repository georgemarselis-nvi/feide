# along with this program. If not, see <https://www.gnu.org/licenses/>.
#
# Layout:
#
#   ${BASE_DN}                     local mdb database, holds exactly one
#                                  entry: the organisation (norEduOrg)
#   ou=people,${BASE_DN}           back-sock subordinate: every request is
#                                  handed to scripts/feide_people.py over a
#                                  Unix socket, which reads Active Directory
#                                  at ${AD_BASE_DN} and formats the values
#
# Nothing about a user is stored here. Every person entry Sikt reads is
# fetched from Active Directory at that moment by feide_people.py.

include		/etc/openldap/schema/core.schema
include		/etc/openldap/schema/cosine.schema
include		/etc/openldap/schema/inetorgperson.schema
include		/etc/openldap/schema/eduperson.schema
include		/etc/openldap/schema/eduorg.schema
include		/etc/openldap/schema/schac.schema
include		/etc/openldap/schema/noredu.schema

pidfile		/var/run/openldap/slapd.pid
argsfile	/var/run/openldap/slapd.args

modulepath	/usr/lib64/openldap
moduleload	back_mdb.la
moduleload	back_sock.la

# TLS. The certificate and key come from certbot on the host and are
# mounted read only. TLS 1.2 stays enabled because Sikt requires it;
# the suite list is the four ECDHE-GCM suites from the README, eased
# towards Feide's full list of twelve only if Sikt fails to connect.
TLSCertificateFile	/etc/openldap/certs/fullchain.pem
TLSCertificateKeyFile	/etc/openldap/certs/privkey.pem
TLSProtocolMin		3.3
TLSCipherSuite		ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256

# Plain LDAP and StartTLS are not offered. The listener is set on the
# slapd command line in entrypoint.sh (ldaps:/// only).
security	ssf=128

loglevel	stats

# Access control. Sikt's crawler binds as the system user named in
# .env and reads everything under the base DN (Sikt ticket #551520).
# Everyone else may only bind: back-sock checks auth access before it
# hands a bind to feide_people.py, and FEIDE binds as each user to check
# the password. Nothing is readable without the system user.
access to attrs=userPassword
	by * none

access to dn.subtree="${BASE_DN}"
	by dn.exact="${SIKT_BIND_DN}" read
	by * auth

#
# 1. People: handed to feide_people.py.
#
# A subordinate database must come before its superior in slapd.conf;
# slapd looks for the superior among the databases defined after it.
#
database	sock
suffix		"ou=people,${BASE_DN}"
subordinate
rootdn		"cn=admin,${BASE_DN}"
readonly	on
socketpath	/var/run/openldap/feide-people.sock

# Every request carries the DN the connection is bound as, so
# feide_people.py can refuse searches from anyone but the system user.
extensions	binddn

#
# 2. The organisation entry: local, static, one entry.
#
database	mdb
suffix		"${BASE_DN}"
rootdn		"cn=admin,${BASE_DN}"
directory	/var/lib/ldap
maxsize		10485760
